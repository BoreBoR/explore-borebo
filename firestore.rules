rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isRoomPlayer(roomData) {
      return signedIn()
        && request.auth.uid in roomData.playerIds;
    }

    function isMatchPlayer(matchData) {
      return signedIn()
        && (
          request.auth.uid == matchData.hostUserId
          || request.auth.uid == matchData.guestUserId
        );
    }

    function isOpenMatch(matchData) {
      return signedIn()
        && matchData.status == 'waiting';
    }

    match /kang_rooms/{roomId} {
      allow create: if signedIn()
        && request.resource.data.playerIds is list
        && request.auth.uid in request.resource.data.playerIds;

      allow read, update, delete: if isRoomPlayer(resource.data);
    }

    match /kang_matches/{matchId} {
      allow create: if signedIn()
        && request.resource.data.hostUserId == request.auth.uid
        && request.resource.data.status == 'waiting';

      allow read: if isOpenMatch(resource.data) || isMatchPlayer(resource.data);

      allow update: if isMatchPlayer(resource.data)
        || (
          isOpenMatch(resource.data)
          && request.resource.data.guestUserId == request.auth.uid
        );

      allow delete: if signedIn()
        && request.auth.uid == resource.data.hostUserId;
    }
  }
}
